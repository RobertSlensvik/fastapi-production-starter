# Copy to .env and adjust per environment.
# Production: load via secrets manager, not from .env files.

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_NAME=fastapi-starter
APP_DEBUG=true
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON=false           # true in production

# ─── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Security ───────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-strong-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY_HEADER=X-API-Key

# CORS — comma-separated origins, or "*" for all (don't use * in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false          # log SQL — useful in dev, never in prod

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute

# ─── Observability ──────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PATH=/metrics
